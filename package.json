{
  "private": true,
  "name": "astra-deck",
  "version": "4.88.0",
  "description": "Chrome/Firefox MV3 extension and Tampermonkey userscript for YouTube enhancement",
  "author": "SysAdminDoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysAdminDoc/Astra-Deck.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build-extension.js && npm run generate:capability-matrix",
    "build:userscript": "node build-extension.js --with-userscript && npm run generate:capability-matrix && npm run release:sbom && npm run release:manifest && npm run release:sign",
    "build:userscript:no-crx": "node build-extension.js --with-userscript --no-crx && npm run generate:capability-matrix && npm run release:sbom && npm run release:manifest && npm run release:sign",
    "release:prepare": "npm run check && npm run release:browser-smokes && npm run build:userscript && npm run release:readiness -- --require-pass && npm run release:health",
    "release:prepare:no-crx": "npm run check && npm run release:browser-smokes && npm run build:userscript:no-crx && npm run release:readiness -- --require-pass && npm run release:health",
    "release:browser-smokes": "npm run smoke:a11y && npm run smoke:light-surfaces && npm run smoke:theme-controls && npm run smoke:zero-ads:live && npm run smoke:live-chat && npm run smoke:firefox && npm run smoke:userscript-managers",
    "build-for-amo": "node scripts/build-for-amo.js",
    "release:sbom": "node scripts/generate-release-sbom.js",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "release:sign": "node scripts/release-signature.js",
    "release:verify-signature": "node scripts/release-signature.js --verify",
    "a11y:evidence": "node scripts/screen-reader-evidence.js",
    "a11y:evidence:template": "node scripts/screen-reader-evidence.js --template",
    "release:readiness": "node scripts/generate-release-readiness.js",
    "release:health": "node scripts/release-health.js",
    "release:promote": "node scripts/release-channels.js promote",
    "release:rollback": "node scripts/release-channels.js rollback",
    "release:channels": "node scripts/release-channels.js validate",
    "release:verify-digests": "node scripts/compare-release-digests.js",
    "policy:actions": "node scripts/generate-actions-policy.js",
    "generate:companion-ports": "node scripts/generate-companion-port-modules.js",
    "generate:capability-matrix": "node scripts/generate-capability-matrix.js",
    "generate:runtime-bootstrap": "node scripts/generate-runtime-bootstrap.js",
    "generate:selector-asset": "node scripts/build-selector-asset.js",
    "build:fixtures": "node scripts/build-selector-fixtures.js",
    "generate:live-chat-css": "node scripts/generate-live-chat-css.js",
    "generate:sidebar": "node scripts/generate-sidebar.js",
    "generate:settings-reference": "node scripts/generate-settings-reference.js",
    "generate:reviewer-resources": "node scripts/generate-reviewer-resource-docs.js --write",
    "i18n:coverage": "node scripts/i18n-coverage.js",
    "i18n:coverage:warn": "node scripts/i18n-coverage.js --warn-feature-identical-above 582",
    "i18n:coverage:gate": "node scripts/i18n-coverage.js --no-write --check-report --check-placeholder-baseline",
    "i18n:copy:gate": "node scripts/check-localizable-ui-copy.js",
    "i18n:raw-error:gate": "node scripts/check-raw-error-copy.js",
    "i18n:pseudolocale": "node scripts/generate-pseudolocale.js",
    "i18n:proofing-export": "node scripts/export-i18n-proofing.js",
    "audit:storage": "node scripts/audit-storage-size.js",
    "capture:watch": "node scripts/capture-watch-mhtml.js",
    "capture:surface": "node scripts/capture-watch-mhtml.js --require-surface",
    "check": "node scripts/run-checks.js",
    "project-facts": "node scripts/project-facts.js --write",
    "check:project-facts": "node scripts/project-facts.js --check",
    "check:zero-ads": "node scripts/check-zero-ad-rules.js",
    "check:selector-asset": "node scripts/build-selector-asset.js --check",
    "check:companion-ports": "node scripts/check-companion-port-catalogue.js",
    "check:chromium-store": "node scripts/check-chromium-store-profile.js",
    "audit:deps": "npm run audit:deps:production && node scripts/audit-dependencies.js",
    "audit:deps:production": "npm audit --omit=dev --audit-level=moderate",
    "check:versions": "node scripts/check-versions.js",
    "check:release-current": "node scripts/check-versions.js --require-release-current",
    "check:settings": "node scripts/check-settings.js",
    "check:shipped-identity": "node scripts/generate-shipped-identity-baseline.js --check",
    "generate:shipped-identity": "node scripts/generate-shipped-identity-baseline.js",
    "check:settings-reference": "node scripts/generate-settings-reference.js --check",
    "check:reviewer-resources": "node scripts/generate-reviewer-resource-docs.js --check",
    "lint": "eslint extension/background.js extension/popup.js extension/runtime-bootstrap.js extension/core/*.js extension/core/selector-packs/*.js extension/features/**/*.js extension/live-chat.js extension/sidepanel.js extension/ytkit.js extension/ytkit-main.js extension/runtime-core-loader.mjs scripts/**/*.js build-extension.js sync-userscript.js",
    "check:firefox": "node scripts/check-firefox-webext.js",
    "smoke:firefox": "node scripts/smoke-firefox-webext.js",
    "smoke:userscript-managers": "node scripts/smoke-userscript-managers.js",
    "smoke:optional-hosts": "node scripts/smoke-chromium-optional-hosts.js",
    "smoke:zero-ads:live": "node scripts/smoke-zero-ads-live.js",
    "smoke:live-chat": "node scripts/smoke-live-chat-frame.js",
    "smoke:settings-overlay": "node scripts/smoke-settings-overlay.js",
    "smoke:settings-userscript": "node scripts/smoke-userscript-settings.js",
    "probe:panel-colors": "node scripts/probe-panel-colors.js",
    "smoke:light-surfaces": "node scripts/probe-light-surfaces.js",
    "smoke:theme-controls": "node scripts/probe-theme-control-regressions.js",
    "smoke:a11y": "node scripts/smoke-headless-a11y.js",
    "smoke:transcript-index": "node scripts/smoke-transcript-index.js",
    "smoke:mv3-lifecycle": "node scripts/smoke-mv3-worker-lifecycle.js",
    "smoke:settings-overlay:fallback": "node scripts/smoke-settings-overlay.js --fallback-only",
    "bench:startup": "node scripts/bench-startup.js",
    "check:startup": "node scripts/bench-startup.js --check --allow-synthetic",
    "check:startup:captured": "node scripts/bench-startup.js --check",
    "bench:steady-state": "node scripts/bench-startup.js --steady-state",
    "check:steady-state": "node scripts/bench-startup.js --check --allow-synthetic --steady-state",
    "audit:a11y": "node scripts/audit-popup-a11y.js",
    "audit:overlays": "node scripts/audit-overlays-a11y.js",
    "audit:contrast": "node scripts/check-contrast.js",
    "audit:light-theme": "node scripts/check-light-theme-lane.js",
    "test": "node --test tests/*.test.js tests/features/*.test.js",
    "check:userscript-symbols": "node scripts/check-userscript-symbols.js",
    "check:userscript-size": "node scripts/check-userscript-size.js"
  },
  "dependencies": {
    "crx3": "^2.0.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "web-ext": "10.6.0",
    "ws": "8.21.3"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.9",
    "shell-quote": "^1.10.0"
  }
}
