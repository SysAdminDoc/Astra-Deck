# Dependency lifecycle scripts are refused by default.
#
# The 2026-08-04 ChainDrop worm spread through ~444 packages by way of
# preinstall hooks carrying forged provenance. This repository needs no
# lifecycle script of its own (package.json declares none) and no dependency
# here builds a native module, so refusing them costs nothing and removes the
# vector entirely. Verified 2026-08-20: `npm ci --ignore-scripts` followed by
# `npm test` (2147 pass) and `npm run check` (31/31 gates).
#
# If a future dependency genuinely needs its install script, run that one
# install deliberately with `--ignore-scripts=false` and record why here
# rather than deleting this file.
ignore-scripts=true
